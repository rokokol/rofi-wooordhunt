#!/usr/bin/env bash
# Answers by site path from $FIXTURES/routes, so a wrong slug — a space left
# unescaped, say — shows up as a 404 instead of a silent hit on the wrong page.
# Two reserved slugs stand in for the failures a saved page cannot express
set -euo pipefail

url="${*: -1}"
path=${url#*://}
path=${path#*/}

# A failure is a line on stderr and an exit code, because that is what curl leaves and
# the modi puts that line on screen — a stub that only set the code would let the suite
# pass over an empty row. The wording is this stub's own and says so: what real curl says
# is checked by tests/live.sh, against real curl
die() {
  printf 'stub curl: (%s) %s\n' "$1" "$2" >&2
  exit "$1"
}

case "$path" in
  word/__timeout__ | переводы/__timeout__) die 28 "no answer for $path" ;;
  word/__boom__ | переводы/__boom__) die 7 "nothing listening for $path" ;;
esac

file=$(grep -v '^#' "$FIXTURES/routes" | awk -F'\t' -v p="$path" '$1 == p { print $2 }')
[[ -n "$file" ]] || die 22 "no route for $path"
cat "$FIXTURES/$file"
